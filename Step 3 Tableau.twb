                <zone h='4889' id='21' type-v2='text' w='33857' x='61643' y='54222'>
                  <formatted-text>
                    <run fontcolor='#333333' fontsize='10'>The variance goes in the same general direction from January to July 2026, indicating a persistent pattern rather than a one-time spike.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#444444' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='3556' id='19' type-v2='text' w='98858' x='571' y='92000'>
                  <formatted-text>
                    <run bold='true'>Key Finding:</run>
                    <run> Sales &amp; Marketing Revenue had the largest variance (-$3.3M) during January-July 2026. Negative variances occured during this time, indicating a persistent pattern</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#444444' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone h='3555' id='20' type-v2='text' w='98858' x='571' y='95556'>
                  <formatted-text>
                    <run bold='true'>Note:</run>
                    <run> All amounts on the dashboard reflect the values from the group&apos;s variance analysis. Revenues and expenses are shown the same as their source-data conventions.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#444444' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
